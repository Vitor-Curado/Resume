{
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/resumes",
    "latex-workshop.latex.auxDir": "%WORKSPACE_FOLDER%/build",
    "latex-workshop.latex.recipe.default": "latexmk (lualatex)",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (lualatex)",
            "tools": [
                "latexmk-lualatex"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-lualatex",
            "command": "latexmk",
            "args": [
                "-lualatex",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-outdir=%OUTDIR%",
                "-auxdir=%WORKSPACE_FOLDER%/build",
                "%DOC%"
            ]
        }
    ],

    "latex-workshop.latex.rootFile.useSubFile": false
}